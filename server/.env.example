PORT=5000
NODE_ENV=development

# JWT
JWT_SECRET=replace_with_a_long_random_string
JWT_EXPIRES_IN=8h

# Google Sheets Service Account
GOOGLE_CLIENT_EMAIL=your-service-account@your-project.iam.gserviceaccount.com
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_KEY_HERE\n-----END PRIVATE KEY-----\n"
GOOGLE_SHEET_ID=your_google_sheet_id
GOOGLE_SHEET_TAB_NAME=Api list
GOOGLE_USERS_TAB_NAME=Users
GOOGLE_ACTIVITY_TAB_NAME=ActivityLog
GOOGLE_EMAIL_AUDIT_TAB_NAME=EmailAuditLog

# CORS - comma separated list of allowed origins
CLIENT_ORIGIN=http://localhost:5173

# SMTP - used to email developers/admins when tasks are assigned, reassigned,
# due dates change, or a task is completed. Leave SMTP_HOST blank to disable
# emails entirely (the app keeps working, sends just get skipped + logged).
SMTP_HOST=smtppro.zoho.in
SMTP_PORT=465
SMTP_USER=your-sending-address@example.com
SMTP_PASSWORD=your_smtp_password
SMTP_SECURE=true
SMTP_DOMAIN=example.com

# Used in notification emails as the "log in here" link
PORTAL_URL=https://your-frontend.vercel.app
