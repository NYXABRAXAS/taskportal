# Leave blank for local dev (Vite proxies /api and /uploads to localhost:5000).
# In production (Vercel), set this to your deployed Render backend URL, e.g.
# https://api-task-portal-server.onrender.com
VITE_API_BASE_URL=

# Optional: shown as a convenience "Open source spreadsheet" link on the Admin
# Settings page. Not required for the app to function.
VITE_SHEET_ID=

